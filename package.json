{
  "name": "dsh-plugin-browser-harness",
  "version": "0.3.1",
  "description": "browser-harness 鎻掍欢锛氳 DeepSeek Harness 鐨?Agent 閫氳繃鏈湴 Chrome CDP 瀹屾垚缃戦〉浜や簰锛堢偣鍑?杈撳叆/瀵艰埅/鎴浘锛夛紝骞舵彁渚?璁剧疆 > 娴忚鍣ㄨ繛鎺?璇婃柇鐣岄潰銆俠rowser-harness plugin: agent-driven local Chrome control via CDP, with a connection diagnostics settings page.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/smoke-test.js",
    "check-update": "node scripts/check-update.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "browser-harness",
    "browser-use",
    "cdp",
    "chrome"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "immediately": true
    }
  }
}
