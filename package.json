{
  "name": "dsh-plugin-browser-harness",
  "version": "0.4.0",
  "description": "browser-harness 插件：让 DeepSeek-Harness 的 Agent 通过本地 Chrome CDP 完成网页交互（点击/输入/导航/截图），并支持在页面上圈选元素写批注、批注自动回到当前会话。Browser-harness plugin: agent-driven local Chrome control via CDP, with an in-page element annotation picker that posts back to the originating session, plus a connection diagnostics settings page.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/smoke-test.js",
    "check-update": "node scripts/check-update.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "browser-harness",
    "browser-use",
    "cdp",
    "chrome",
    "annotation",
    "shadow-dom",
    "element-picker"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "immediately": true
    }
  }
}
